OPENROUTER_API_KEY=your-openrouter-api-key-here
# Must match Vite proxy in client/vite.config.js (default 3008).
PORT=3008
# Specific stable model from OpenRouter (Google Gemini 2.0 Flash is free and reliable).
# Other options: meta-llama/llama-3.2-3b-instruct:free, google/gemini-2.0-flash-001
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# When the primary model fails, try these next (comma-separated).
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001
# URL where the frontend is running (required by OpenRouter for proper headers).
OPENROUTER_HTTP_REFERER=http://localhost:5173
# Frontend origin for CORS configuration.
CLIENT_ORIGIN=http://localhost:5173
# Optional: extra attempts when OpenRouter returns transient provider errors (default 2).
# OPENROUTER_RETRY_COUNT=2
# Optional: backoff in ms for rate-limit retries, comma-separated per attempt (default 5000,14000,28000).
# OPENROUTER_RATE_LIMIT_BACKOFF_MS=8000,20000,40000
