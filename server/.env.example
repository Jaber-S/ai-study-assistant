OPENROUTER_API_KEY=your_key_here
# Must match Vite proxy in client/vite.config.js (default 3001). Do not use 5173 — that is the frontend dev server.
PORT=3001
# Specific free model (stable id on OpenRouter; see https://openrouter.ai/meta-llama/llama-3.2-3b-instruct:free ).
# For stronger output when available: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free
# When the primary free model is rate-limited on one provider, try these next (comma-separated).
OPENROUTER_FALLBACK_MODELS=openrouter/free
CLIENT_ORIGIN=http://localhost:5173
# Optional: extra attempts when OpenRouter returns transient provider errors (default 2 retries after first try).
# OPENROUTER_RETRY_COUNT=2
# Optional: backoff in ms for rate-limit retries, comma-separated per attempt (default 5000,14000,28000).
# OPENROUTER_RATE_LIMIT_BACKOFF_MS=8000,20000,40000
